# URL của API. Trong Docker để mặc định "/api" -> nginx proxy sang backend (cùng origin).
VITE_API_URL=/api

# ─────────────────────────────────────────────────────────────────────────────
# THÔNG BÁO ĐẨY cho bệnh nhân dùng WEB / PWA  (TUỲ CHỌN)
#
# Để TRỐNG thì tính năng nằm im hoàn toàn: không nạp SDK, không xin quyền, không lỗi,
# và nút "Bật nhắc" cũng không hiện ra. App Android trên Google Play vẫn nhận push
# bình thường vì nó đi đường riêng.
#
# Lấy giá trị ở Firebase Console, dự án đang dùng cho backend:
#   1. Project Settings › General › Your apps › thêm một Web App
#      -> chép apiKey / authDomain / projectId / messagingSenderId / appId
#   2. Project Settings › Cloud Messaging › Web Push certificates › "Generate key pair"
#      -> chép khoá đó vào VITE_FIREBASE_VAPID_KEY
#
# Đây là khoá CÔNG KHAI phía trình duyệt theo đúng thiết kế của Firebase (khác hẳn
# service account của backend — cái đó là bí mật, tuyệt đối không đưa lên frontend).
#
# Lưu ý iOS: Safari chỉ cho phép push khi người dùng đã "Thêm vào màn hình chính".
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

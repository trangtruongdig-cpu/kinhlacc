---
// KhungSeoYKhoa.astro — Khung SEO cho trang Bệnh Học và Châm Cứu Trị Bệnh.
//
// Chép từ build-dict.mjs (bản đang phục vụ /benh-hoc/ và /cham-cuu-tri-benh/ hiện nay).
// Khác KhungSeoBaiViet ở chỗ dùng MedicalWebPage + MedicalEntity thay cho Article: đây là
// trang tra cứu y khoa, không phải bài viết có tác giả.
import { getEmDashCollection } from "emdash";
import { rutNguon, citationLd } from "../utils/trich-dan";

const SITE = "Kinh Lạc Trương Gia";
const NGUOI_DUYET = "Trương Đình Trang";

interface Props {
	entry: any;
	loai: "benh_hoc" | "cham_cuu_tri_benh" | "huyet_vi";
	/** Mục cùng tên bệnh ở nhóm kia, để dệt liên kết chéo như bản tĩnh đang làm. */
	cheo?: { slug: string; ten: string } | null;
	faq?: { q: string; a: string }[];
}
const { entry, loai, cheo = null, faq = [] } = Astro.props;
const d = entry?.data ?? {};

const goc = Astro.site?.origin ?? Astro.url.origin;
// Tên collection dùng gạch dưới (EmDash bắt buộc), URL dùng gạch ngang.
const NHOM = {
	benh_hoc: { duong: "benh-hoc", nhan: "Bệnh Học" },
	cham_cuu_tri_benh: { duong: "cham-cuu-tri-benh", nhan: "Châm Cứu Trị Bệnh" },
	huyet_vi: { duong: "huyet", nhan: "Huyệt Vị" },
} as const;
const duong = NHOM[loai].duong;
const url = `${goc}/${duong}/${entry.slug}/`;
const nhanNhom = NHOM[loai].nhan;

const capNhat = (entry.data?.updatedAt ?? entry.updatedAt)
	? new Date(entry.data?.updatedAt ?? entry.updatedAt).toISOString().slice(0, 10)
	: "";

// Trích dẫn rút từ CHÍNH nội dung: mọi ngoặc đơn chứa tên nguồn trong các phần văn xuôi.
// Đây là tín hiệu E-E-A-T mạnh nhất cho một trang y khoa — mạnh hơn cả dòng "đã rà soát".
const nguon = rutNguon(
	d.dai_cuong, d.nguyen_nhan, d.chan_doan, d.dieu_tri, d.benh_an, d.tham_khao, d.trieu_chung,
	// các phần riêng của huyệt
	d.y_nghia_ten, d.dac_tinh, d.vi_tri, d.giai_phau, d.tac_dung, d.chu_tri, d.cham_cuu, d.xuat_xu,
);

// Nối trích dẫn với thư mục nguồn: có trong thư mục thì thành liên kết sang trang nguồn,
// chưa có thì vẫn hiện nhưng đánh dấu để người biên tập biết mà bổ sung.
// Nạp cả thư mục một lần rồi tra trong bộ nhớ — rẻ hơn gọi từng nguồn, và trang đã được đệm
// nên chi phí chỉ nằm ở lần dựng đầu.
const chuanHoa = (x: string) => String(x || "").toLowerCase().normalize("NFD")
	.replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, " ").trim();
let thuMuc = new Map<string, string>();
try {
	const { entries } = await getEmDashCollection("nguon_y_van", { limit: 3000 });
	thuMuc = new Map(entries.map((e: any) => [chuanHoa(e.data.title), e.slug ?? e.id]));
} catch { /* chưa nhập thư mục thì bỏ qua, trích dẫn vẫn hiện dạng chữ */ }
const nguonCoLink = nguon.map((n) => ({ ...n, slugNguon: thuMuc.get(chuanHoa(n.ten)) }));
const soNoi = nguonCoLink.filter((n) => n.slugNguon).length;

const jsonLd: any[] = [
	{
		"@context": "https://schema.org", "@type": "MedicalWebPage",
		name: d.title, inLanguage: "vi", url,
		about: { "@type": "MedicalEntity", name: d.title,
			...(d.doi_chieu_benh_danh ? { alternateName: d.doi_chieu_benh_danh } : {}) },
		publisher: { "@type": "Organization", name: SITE,
			logo: { "@type": "ImageObject", url: `${goc}/favicon.svg` } },
		...(nguon.length ? { citation: citationLd(nguon) } : {}),
	},
	{
		"@context": "https://schema.org", "@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Trang Chủ", item: `${goc}/` },
			{ "@type": "ListItem", position: 2, name: "Từ Điển", item: `${goc}/thu-vien` },
			{ "@type": "ListItem", position: 3, name: nhanNhom, item: `${goc}/${duong}/` },
			{ "@type": "ListItem", position: 4, name: d.title, item: url },
		],
	},
];
if (faq.length)
	jsonLd.push({
		"@context": "https://schema.org", "@type": "FAQPage",
		mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q,
			acceptedAnswer: { "@type": "Answer", text: f.a } })),
	});
---

{jsonLd.map((o) => (
	<script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, "\\u003c")} />
))}

<nav class="bl-crumb">
	<a href="/">Trang Chủ</a> › <a href="/thu-vien">Từ Điển</a> ›
	<a href={`/${duong}/`}>{nhanNhom}</a> › <span>{d.title}</span>
</nav>

<p class="dl-byline">
	<span class="bl-review-badge">✔ Đã rà soát chuyên môn</span> {NGUOI_DUYET}
	{capNhat && <> · Cập nhật {capNhat}</>}
</p>

{d.doi_chieu_benh_danh && (
	<p class="dl-doi-chieu"><strong>Đối chiếu bệnh danh:</strong> {d.doi_chieu_benh_danh}</p>
)}

<slot />

{faq.length > 0 && (
	<section class="bl-faq">
		<h2>Câu Hỏi Thường Gặp</h2>
		{faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
	</section>
)}

{cheo && (
	<div class="dl-cross">
		<a href={`/${loai === "cham_cuu_tri_benh" ? "benh-hoc" : "cham-cuu-tri-benh"}/${cheo.slug}/`}>
			{loai === "cham_cuu_tri_benh" ? "📖 Xem Bệnh Học về" : "🩺 Xem cách Châm Cứu Trị"} “{cheo.ten}” →
		</a>
	</div>
)}

<div class="bl-cta"><a href="/xem-3d">Khám Phá Đồ Hình Kinh Lạc 3D →</a></div>

{nguon.length > 0 && (
	<section class="dl-nguon">
		<h2>Nguồn Trích Dẫn <span class="dl-nguon-dem">{nguon.length}</span>
			{soNoi > 0 && <span class="dl-nguon-noi">{soNoi} có trong thư mục</span>}
		</h2>
		<ol class="dl-nguon-ds">
			{nguonCoLink.map((n) => (
				<li class={n.loai === "tap_chi" ? "dl-nguon-tc" : "dl-nguon-sach"}>
					<span class="dl-nguon-loai">{n.loai === "tap_chi" ? "Tạp chí" : "Sách"}</span>
					{n.slugNguon
						? <a class="dl-nguon-ten" href={`/nguon/${n.slugNguon}/`}>{n.ten}</a>
						: <span class="dl-nguon-ten">{n.ten}</span>}
					{n.nam && <span class="dl-nguon-nam">{n.nam}</span>}
					{n.so && <span class="dl-nguon-so">số {n.so}</span>}
					{n.trang && <span class="dl-nguon-trang">tr. {n.trang}</span>}
				</li>
			))}
		</ol>
	</section>
)}

<aside class="bl-disclaimer" role="note">
	<p class="bl-disc-title">⚕️ Miễn Trừ Y Tế</p>
	<p>Thông tin trên trang này chỉ mang tính <strong>tham khảo &amp; học tập</strong> theo lý luận
	Đông Y, không thay thế việc thăm khám, chẩn đoán hay điều trị của thầy thuốc có chuyên môn.
	Khi có vấn đề sức khoẻ, hãy đến cơ sở y tế.</p>
	<p class="bl-disc-meta">Rà soát chuyên môn: {NGUOI_DUYET} · Xem <a href="/quy-trinh-bien-tap">Quy Trình Biên Tập</a>.</p>
</aside>

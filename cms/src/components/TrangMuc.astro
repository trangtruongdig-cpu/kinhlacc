---
// TrangMuc.astro — Thân trang mục lục của một mục thư viện.
//
// Dùng chung cho 7 đường mục lục CŨ (/huyet/, /benh-hoc/, /duoc-lieu/…). Những đường đó
// đang nằm trong sitemap và trong chỉ mục Google, nên chúng phải là đường CHÍNH; các
// đường /thu-vien/<bo>/ chỉ chuyển hướng về đây.
//
// Đây cũng là ĐƯỜNG BÒ của Google: mọi mục từ phải có ít nhất một liên kết tĩnh trỏ
// tới, mà ô tìm thì bot không gõ được — danh sách ở cột trái mới là thứ dẫn bot vào.
import ThuVienKhung from "../layouts/ThuVienKhung.astro";
import { danhSachMuc } from "../lib/traCuu";

interface Props { bo: string }
const { bo } = Astro.props;
const muc = await danhSachMuc();
const m = muc.find((x) => x.bo === bo);
if (!m || !m.so_muc) return Astro.redirect("/thu-vien/", 302);

const chuCai = (Astro.url.searchParams.get("van") || "").toUpperCase().slice(0, 1) || undefined;
const the = Astro.url.searchParams.get("the") || undefined;
const soMuc = (n: number) => n.toLocaleString("vi-VN");
---

<ThuVienKhung
	bo={bo}
	title={`${m.nhan} — Thư Viện Đông Y`}
	description={m.mo_ta}
	khongLap={!!chuCai || !!the}
>
	{/* Bản cũ: chưa chọn mục nào thì cột phải chỉ có CÂU MỜI (.mer-welcome), không có
	    danh sách nào cả. Trước đây tôi tự thêm khối "Mở đầu danh mục" — bản cũ không hề
	    có, và nó cũng thừa: cột trái đã có sẵn liên kết tới từng mục cho cả người đọc
	    lẫn bò của Google. */}
	<div class="mer-welcome">
		<h3>{m.nhan}</h3>
		<p>{m.mo_ta}</p>
		<p>
			Chọn một mục ở danh sách bên trái để xem chi tiết — hoặc gõ vào ô tìm,
			<b> không dấu cũng ra</b>.
		</p>
		<p class="tv-dan-so">{soMuc(m.so_muc)} mục từ</p>
	</div>
</ThuVienKhung>

<style>
	.mer-welcome p { margin: 0 0 8px; line-height: 1.7; }
	.mer-welcome .tv-dan-so {
		margin-top: 14px;
		font-weight: 700;
		color: var(--brown-700);
	}
</style>

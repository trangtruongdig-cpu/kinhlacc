---
// Trang Bài Thuốc — GIỮ NGUYÊN /bai-thuoc/<slug>/ của bản tĩnh (slug CHỮ, khác dược liệu
// vốn dùng id số).
export const prerender = false;

import { getEmDashEntry, decodeSlug } from "emdash";
import ThanMuc from "../../components/ThanMuc.astro";
import ThuVienKhung from "../../layouts/ThuVienKhung.astro";
import "../../styles/tu-dien.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint, isPreview } = await getEmDashEntry("bai_thuoc", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled && !isPreview) Astro.cache.set(cacheHint);

const d = entry.data;

// thanh_phan là mảng { id, ten, lieu }. id trỏ sang vị thuốc → /duoc-lieu/<id>/.
type Vi = { id?: number | string; ten?: string; lieu?: string };
const vi: Vi[] = Array.isArray(d.thanh_phan) ? d.thanh_phan : [];
const coVi = vi.filter((x) => String(x?.ten || "").trim());

const choIndex = d.cho_index === true || d.cho_index === 1;
const moTa =
	`Bài thuốc ${d.title}${d.xuat_xu ? ` (${d.xuat_xu})` : ""}: thành phần, ` +
	`cách dùng và tác dụng theo y văn Đông Y.`;
---

<ThuVienKhung bo="bai_thuoc" slug={slug} title={`${d.title} — Bài Thuốc Đông Y`} description={moTa} khongLap={!choIndex}>
	{isPreview && (
		<div class="bang-xem-truoc" role="alert"><strong>Bản nháp — đang xem trước.</strong></div>
	)}

	<nav class="bt-vet" aria-label="Đường dẫn">
		<a href="/thu-vien/">Thư Viện</a> › <a href="/thu-vien/bai_thuoc/">Bài Thuốc</a> › <span>{d.title}</span>
	</nav>

	<div class="acu-head"><h2>{d.title}</h2></div>

	{(d.xuat_xu || d.tac_gia || d.so_benh) && (
		<p class="bt-xuat-xu">
			{d.xuat_xu && <span>Xuất xứ: <b>{d.xuat_xu}</b></span>}
			{d.tac_gia && <span>Tác giả: <b>{d.tac_gia}</b></span>}
			{d.so_benh ? (
				<span class="bt-so-benh">
					Dùng trong {Number(d.so_benh).toLocaleString("vi-VN")} bệnh (Đông Y)
				</span>
			) : null}
		</p>
	)}

	{coVi.length > 0 && (
		<section class="field">
			<h3><span class="fi">🧪</span><span class="ft">THÀNH PHẦN ({coVi.length} vị)</span></h3>
			<ul class="bt-vi">
				{coVi.map((x) => (
					<li>
						{x.id ? <a href={`/duoc-lieu/${x.id}/`}>{x.ten}</a> : <span>{x.ten}</span>}
						{x.lieu && <em>{x.lieu}</em>}
					</li>
				))}
			</ul>
		</section>
	)}

	<ThanMuc nhan="TÁC DỤNG" value={d.tac_dung} />
	<ThanMuc nhan="CÁCH DÙNG" value={d.cach_dung} />
	<ThanMuc nhan="GHI CHÚ" value={d.ghi_chu} />
</ThuVienKhung>

<style>
	.bt-vet {
		font-size: 0.83rem;
		color: var(--chu-nhat, #6b5f52);
		margin-bottom: 0.4rem;
	}
	.bt-vet a {
		color: var(--nau-700, #6f4a22);
		text-decoration: none;
	}
	.bt-xuat-xu {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		margin: 0 0 1.6rem;
		padding: 0.7rem 1rem;
		background: var(--nau-50, #faf6ef);
		border: 1px solid var(--nau-100, #f1e7d6);
		border-radius: 9px;
		font-size: 0.89rem;
		color: var(--chu-nhat, #6b5f52);
	}
	.bt-xuat-xu b {
		color: var(--nau-800, #54391d);
		font-weight: 600;
	}
	.bt-so-benh {
		font-weight: 600;
		color: #fff;
		background: var(--nau-600, #8a5e28);
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		font-size: 0.8rem;
	}
	.bt-vi {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		column-gap: 2rem;
	}
	.bt-vi li {
		break-inside: avoid;
		padding: 0.34rem 0;
		border-bottom: 1px solid var(--nau-50, #faf6ef);
		display: flex;
		justify-content: space-between;
		gap: 0.8rem;
	}
	.bt-vi a {
		color: var(--nau-800, #54391d);
		font-weight: 500;
		text-decoration: none;
	}
	.bt-vi a:hover {
		color: var(--do-an, #9d2b25);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.bt-vi em {
		font-style: normal;
		font-size: 0.85rem;
		color: var(--nau-500, #a4743a);
		white-space: nowrap;
	}
	@media (max-width: 560px) {
		.bt-so-benh {
		font-weight: 600;
		color: #fff;
		background: var(--nau-600, #8a5e28);
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		font-size: 0.8rem;
	}
	.bt-vi {
			columns: 1;
		}
	}
</style>

---
// /huyet/id/<mã số cũ>/ — Đổi mã của bộ Từ Điển 1.059 sang địa chỉ huyệt.
//
// Kết Quả Đo và ngăn kéo Kinh Mạch 3D đẩy link dạng ?acu=<id số> (di sản từ webapp gốc).
// Đường này giữ cho những link đó sống sau khi tab Từ Điển trong app bị gỡ.
export const prerender = false;
import { truyVan } from "../../../lib/csdl";

const ma = Number(Astro.params.ma);
if (!Number.isInteger(ma) || ma <= 0) return Astro.redirect("/huyet/", 302);

const r = await truyVan<{ slug: string }>(
	"SELECT slug FROM ec_huyet_vi WHERE ma_cu = $1 AND deleted_at IS NULL AND status = 'published' LIMIT 1",
	[ma],
);
// Không tìm thấy thì về mục lục chứ không 404: link cũ vẫn dẫn tới chỗ tra được.
return Astro.redirect(r[0] ? `/huyet/${r[0].slug}/` : "/huyet/", r[0] ? 301 : 302);
---

---
// /blog/<slug>/ — CMS dựng trang bài với ĐÚNG khuôn của bản tĩnh (frontend/scripts/
// build-blog.mjs): cùng <head>, topbar, footer, lớp bl-* và /blog/blog.css.
//
// Vì sao không dùng Base.astro: nginx phục vụ tệp tĩnh trước, không có thì mới rơi về đây
// (bài mới Publish chưa qua lần build nào). Hai đường phải ra CÙNG một trang — Base.astro là
// theme mẫu, không có CSS cho bl-*. Khuôn nằm ở src/lib/khung-blog.mjs, có phép kiểm chống
// lệch với bản tĩnh. Trang này trả thẳng Response nên phần template bên dưới để trống.
import { getEmDashEntry, decodeSlug } from "emdash";

import { baiTuEntry, trangBai, trang404 } from "../../lib/khung-blog.mjs";
import { docBaiDaDang, nhanPhanLoai, gocBlog, gaIdBlog } from "../../lib/doc-bai-blog";

const opt = { domain: gocBlog(), gaId: gaIdBlog() };

// 404 THẬT (mã 404 + thân tiếng Việt cùng khung, noindex). Không redirect sang /404:
// 302 → trang 200 là "soft 404", Google giữ URL chết trong chỉ mục.
const khongThay = () =>
	new Response(trang404(opt), {
		status: 404,
		headers: {
			"Content-Type": "text/html; charset=utf-8",
			"X-Robots-Tag": "noindex",
			"Cache-Control": "no-store",
		},
	});

const slug = decodeSlug(Astro.params.slug);
if (!slug) return khongThay();

// isPreview: bật khi mở qua link "Xem trên site" của admin — middleware của EmDash xác
// minh token đã ký rồi mới cho getEmDashEntry trả BẢN NHÁP thay vì bản đã đăng.
const { entry: post, cacheHint, isPreview } = await getEmDashEntry("bai_viet", slug);
if (!post) return khongThay();

// Không được cache trang xem trước: cache lại thì bản nháp rò ra cho người đọc thường.
if (Astro.cache?.enabled && !isPreview) Astro.cache.set(cacheHint);

// Bài liên quan chọn trong các bài đã đăng VÀ được index (như bản tĩnh: `published`).
// Đọc danh sách hỏng thì vẫn dựng trang, chỉ thiếu khối "Bài Liên Quan".
let daDang: Awaited<ReturnType<typeof docBaiDaDang>>["bai"] = [];
try {
	daDang = (await docBaiDaDang()).bai.filter((b) => b.index !== false);
} catch (e) {
	console.warn("[blog] không đọc được danh sách bài để chọn bài liên quan:", e);
}

const phanLoai = (await nhanPhanLoai([post.data.id])).get(post.data.id);
const bai = baiTuEntry(post, phanLoai);

const html = trangBai(bai, daDang, { ...opt, xemTruoc: Boolean(isPreview) });

return new Response(html, {
	status: 200,
	headers: {
		"Content-Type": "text/html; charset=utf-8",
		...(isPreview ? { "Cache-Control": "no-store", "X-Robots-Tag": "noindex" } : {}),
		...(!isPreview && bai.index === false ? { "X-Robots-Tag": "noindex, nofollow" } : {}),
	},
});

---
// /blog/ — danh sách bài đã đăng, mới nhất trước, đúng khuôn dist/blog/index.html của bản
// tĩnh (title/description/JSON-LD Blog y như build-blog.mjs → indexPage). Khuôn ở
// src/lib/khung-blog.mjs; trang trả thẳng Response nên phần template để trống.
import { trangDanhSach } from "../../lib/khung-blog.mjs";
import { docBaiDaDang, gocBlog, gaIdBlog } from "../../lib/doc-bai-blog";

const { bai, cacheHint } = await docBaiDaDang();

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Bài noindex (ô SEO "no index" hoặc cho_index = false) không lên danh sách — như bản tĩnh.
const html = trangDanhSach(
	bai.filter((b) => b.index !== false),
	{ domain: gocBlog(), gaId: gaIdBlog() },
);

return new Response(html, {
	status: 200,
	headers: { "Content-Type": "text/html; charset=utf-8" },
});
---

---
// Trang Đường Kinh — GIỮ NGUYÊN /kinh/<slug>/ của bản tĩnh.
export const prerender = false;

import { getEmDashEntry, decodeSlug } from "emdash";
import VanBanYVan from "../../components/VanBanYVan.astro";
import ThuVienKhung from "../../layouts/ThuVienKhung.astro";
import { urlAnh } from "../../utils/anh";
import "../../styles/tu-dien.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint, isPreview } = await getEmDashEntry("kinh_mach", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled && !isPreview) Astro.cache.set(cacheHint);

const d = entry.data;
const goc = Astro.url.origin;

const PHAN: [string, string][] = [
	["dai_cuong", "Đại Cương"],
	["dac_tinh", "Đặc Tính"],
	["van_hanh", "Vận Hành"],
	["duong_chinh", "Đường Kinh Chính"],
	["kinh_can", "Kinh Cân"],
	["kinh_biet", "Kinh Biệt"],
	["lac_doc", "Lạc Dọc"],
	["lac_ngang", "Lạc Ngang"],
	["trieu_chung", "Triệu Chứng"],
	["chu_tri", "Chủ Trị"],
	["dieu_tri", "Điều Trị"],
];
const coPhan = PHAN.filter(([k]) => d[k]);

// Sơ đồ đi kèm từng phần — hiện ngay dưới đúng phần nó minh hoạ.
const ANH_CUA: Record<string, string> = {
	duong_chinh: "anh_chinh",
	kinh_can: "anh_can",
	kinh_biet: "anh_biet",
	lac_doc: "anh_doc",
	lac_ngang: "anh_ngang",
};
const anhTongQuat = urlAnh(d.anh_tong_quat, goc) || urlAnh(d.anh_so_do, goc);

// Danh sách huyệt: dòng đầu là câu tổng kết, các dòng sau là tên huyệt.
const dsHuyet = String(d.huyet_ds || "")
	.split(/\n+/).map((x) => x.trim()).filter(Boolean)
	.filter((x) => !/^Tổng cộng/i.test(x));

const moTa = `${d.title}: đường vận hành, huyệt vị, triệu chứng và chủ trị theo Đông Y.`;
---

<ThuVienKhung bo="kinh_mach" slug={slug} title={`${d.title} — Tra Cứu Kinh Mạch`} description={moTa}>
	{isPreview && (
		<div class="bang-xem-truoc" role="alert"><strong>Bản nháp — đang xem trước.</strong></div>
	)}

	<nav class="km-vet" aria-label="Đường dẫn">
		<a href="/thu-vien/">Thư Viện</a> › <a href="/thu-vien/kinh_mach/">Tra Cứu Kinh</a> › <span>{d.title}</span>
	</nav>

	<h1>{d.title}</h1>

	{(d.ma || d.ten_khac || d.tom_tat_huyet) && (
		<p class="km-meta">
			{d.ma && <span class="km-ma">{d.ma}</span>}
			{d.ten_khac && <span>{d.ten_khac}</span>}
			{d.tom_tat_huyet && <span>{d.tom_tat_huyet}</span>}
		</p>
	)}

	{anhTongQuat && (
		<figure class="km-anh">
			<img src={anhTongQuat} alt={`Sơ đồ tổng quát ${d.title}`} loading="lazy" />
			<figcaption>Sơ đồ tổng quát — {d.title}</figcaption>
		</figure>
	)}

	{coPhan.map(([k, nhan]) => {
		const anh = ANH_CUA[k] ? urlAnh(d[ANH_CUA[k]], goc) : undefined;
		return (
			<section class="dl-phan">
				<h2>{nhan}</h2>
				<VanBanYVan value={d[k]} />
				{anh && (
					<figure class="km-anh">
						<img src={anh} alt={`${nhan} — ${d.title}`} loading="lazy" />
						<figcaption>{nhan} — {d.title}</figcaption>
					</figure>
				)}
			</section>
		);
	})}

	{dsHuyet.length > 0 && (
		<section class="dl-phan">
			<h2>Các Huyệt Trên Kinh ({dsHuyet.length})</h2>
			<ul class="km-huyet">
				{dsHuyet.map((h) => (
					<li>{h}</li>
				))}
			</ul>
		</section>
	)}
</ThuVienKhung>

<style>
	.km-vet {
		font-size: 0.83rem;
		color: var(--chu-nhat, #6b5f52);
		margin-bottom: 0.4rem;
	}
	.km-vet a {
		color: var(--nau-700, #6f4a22);
		text-decoration: none;
	}
	.km-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin: 0 0 1.5rem;
		font-size: 0.9rem;
		color: var(--chu-nhat, #6b5f52);
	}
	.km-ma {
		font-weight: 700;
		color: #fff;
		background: var(--nau-600, #8a5e28);
		padding: 0.12rem 0.5rem;
		border-radius: 5px;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}
	.km-anh {
		margin: 1.1rem 0 0;
		text-align: center;
	}
	.km-anh img {
		max-width: 100%;
		height: auto;
		border: 1px solid var(--nau-100, #f1e7d6);
		border-radius: 10px;
		background: #fff;
	}
	.km-anh figcaption {
		margin-top: 0.45rem;
		font-size: 0.8rem;
		color: var(--chu-nhat, #6b5f52);
	}
	.km-huyet {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 3;
		column-gap: 1.6rem;
	}
	.km-huyet li {
		break-inside: avoid;
		padding: 0.26rem 0;
		border-bottom: 1px solid var(--nau-50, #faf6ef);
		font-size: 0.95rem;
	}
	@media (max-width: 640px) {
		.km-huyet {
			columns: 2;
		}
	}
</style>

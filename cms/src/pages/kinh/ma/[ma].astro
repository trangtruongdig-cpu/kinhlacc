---
// /kinh/ma/<mã kinh>/ — Đổi mã quốc tế (LU, LI, ST…) sang địa chỉ đường kinh.
// Ngăn kéo Kinh Mạch 3D đẩy link dạng #meridian/<mã>.
export const prerender = false;
import { truyVan } from "../../../lib/csdl";

const ma = String(Astro.params.ma || "").trim().toUpperCase().slice(0, 4);
if (!/^[A-Z]{2,4}$/.test(ma)) return Astro.redirect("/kinh/", 302);

const r = await truyVan<{ slug: string }>(
	"SELECT slug FROM ec_kinh_mach WHERE upper(ma) = $1 AND deleted_at IS NULL AND status = 'published' LIMIT 1",
	[ma],
);
return Astro.redirect(r[0] ? `/kinh/${r[0].slug}/` : "/kinh/", r[0] ? 301 : 302);
---

---
// Trang Châm Cứu Trị Bệnh — GIỮ NGUYÊN đường dẫn /cham-cuu-tri-benh/<slug>/ của bản tĩnh.
import { getEmDashEntry, getEmDashCollection, decodeSlug } from "emdash";
import VanBanYVan from "../../components/VanBanYVan.astro";
import "../../styles/tu-dien.css";
import Base from "../../layouts/Base.astro";
import KhungSeoYKhoa from "../../components/KhungSeoYKhoa.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint, isPreview } = await getEmDashEntry("cham_cuu_tri_benh", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled && !isPreview) Astro.cache.set(cacheHint);

const { entries: bh } = await getEmDashCollection("benh_hoc", { limit: 200 });
const cheoRec = bh.find((x) => (x.slug ?? x.id) === slug);
const cheo = cheoRec ? { slug: cheoRec.slug ?? cheoRec.id, ten: cheoRec.data.title } : null;

const PHAN: [string, string][] = [
	["dai_cuong", "Đại Cương"], ["nguyen_nhan", "Nguyên Nhân"],
	["trieu_chung", "Triệu Chứng"], ["dieu_tri", "Điều Trị"],
];
const coPhan = PHAN.filter(([k]) => entry.data[k]);
const moTa = `${entry.data.title}: triệu chứng, nguyên nhân và cách châm cứu điều trị theo Đông Y.`;
---

<Base title={`${entry.data.title} — Châm Cứu Trị Bệnh`} description={moTa} type="article">
	{isPreview && (
		<div class="bang-xem-truoc" role="alert"><strong>Bản nháp — đang xem trước.</strong></div>
	)}
	<main class="bl-main"><article class="bl-article dl-article">
		<KhungSeoYKhoa entry={entry} loai="cham_cuu_tri_benh" cheo={cheo}>
			<h1>{entry.data.title}</h1>
			{coPhan.map(([k, nhan]) => (
				<section class="dl-phan">
					<h2>{nhan}</h2>
					<VanBanYVan value={entry.data[k]} />
				</section>
			))}
		</KhungSeoYKhoa>
	</article></main>
</Base>

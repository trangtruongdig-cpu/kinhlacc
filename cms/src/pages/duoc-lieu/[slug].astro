---
// Trang Dược Liệu — GIỮ NGUYÊN /duoc-lieu/<ID SỐ>/ của bản tĩnh.
// Slug trong CMS chính là id số; đổi sang slug chữ là gãy mọi liên kết cũ và mọi trang
// đã lên chỉ mục Google.
export const prerender = false;

import { getEmDashEntry, decodeSlug } from "emdash";
import ThanMuc from "../../components/ThanMuc.astro";
import ThuVienKhung from "../../layouts/ThuVienKhung.astro";
import { urlAnh } from "../../utils/anh";
import "../../styles/tu-dien.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint, isPreview } = await getEmDashEntry("duoc_lieu", slug);
if (!entry) return Astro.redirect("/404");
if (Astro.cache?.enabled && !isPreview) Astro.cache.set(cacheHint);

const d = entry.data;

const PHAN: [string, string][] = [
	["mo_ta", "Mô Tả"],
	["tinh_vi_quy_kinh", "Tính Vị Quy Kinh"],
	["chu_tri", "Chủ Trị"],
	["thanh_phan_hoa_hoc", "Thành Phần Hoá Học"],
	["duoc_ly", "Tác Dụng Dược Lý"],
	["nuoi_duong", "Nuôi Trồng — Thu Hái"],
	["bao_che", "Bào Chế"],
	["don_thuoc", "Đơn Thuốc Kinh Nghiệm"],
	["xuat_xu", "Xuất Xứ"],
	["tham_khao", "Tham Khảo"],
];
const coPhan = PHAN.filter(([k]) => d[k]);

const anh = urlAnh(d.anh, Astro.url.origin);

// Bản cũ hiện Tính / Vị / Quy kinh / Công dụng / Kiêng kỵ thành CHIP chứ không phải
// bảng chữ — giữ đúng như vậy. Mỗi chip có sắc riêng để mắt phân biệt nhóm.
const tach = (x?: string | null) =>
	String(x || "").split(/[,;/]/).map((t) => t.trim()).filter(Boolean);

const chipTinh = tach(d.tinh);
const chipVi = tach(d.vi);
const chipQuyKinh = tach(d.quy_kinh);
const chipCongDung = tach(d.cong_dung_ds);
const chipKiengKy = tach(d.kieng_ky_ds);

// Những trường còn lại vẫn hợp với bảng: danh pháp và liều dùng.
const bang = [
	d.ten_khac && ["Tên khác", d.ten_khac],
	d.ten_khoa_hoc && ["Tên khoa học", d.ten_khoa_hoc],
	d.ho_khoa_hoc && ["Họ", d.ho_khoa_hoc],
	d.ten_han && ["Tên Hán", d.ten_han],
	d.ten_pinyin && ["Pinyin", d.ten_pinyin],
	d.bo_phan_dung && ["Bộ phận dùng", d.bo_phan_dung],
	d.lieu_dung && ["Liều dùng", d.lieu_dung],
	d.so_bai_thuoc && ["Dùng trong", `${Number(d.so_bai_thuoc).toLocaleString("vi-VN")} bài thuốc`],
].filter(Boolean) as [string, string][];

// cho_index = 0 nghĩa là vị này chưa có phần văn xuôi nào — cùng phép chặn với bản tĩnh.
const choIndex = d.cho_index === true || d.cho_index === 1;
const moTa =
	d.cong_dung_tom_tat ||
	`Vị thuốc ${d.title}: tính vị, quy kinh, công dụng, liều dùng và kiêng kỵ theo Đông Y.`;
---

<ThuVienKhung bo="duoc_lieu" slug={slug} title={`${d.title} — Vị Thuốc Đông Y`} description={moTa} khongLap={!choIndex}>
	{isPreview && (
		<div class="bang-xem-truoc" role="alert"><strong>Bản nháp — đang xem trước.</strong></div>
	)}

	<nav class="dl-vet" aria-label="Đường dẫn">
		<a href="/thu-vien/">Thư Viện</a> › <a href="/thu-vien/duoc_lieu/">Dược Liệu</a> › <span>{d.title}</span>
	</nav>

	<div class="acu-head"><h2>{d.title}</h2></div>

	{anh && (
		<figure class="dl-anh">
			<img src={anh} alt={`Vị thuốc ${d.title}`} loading="lazy" />
			<figcaption>{d.ten_khoa_hoc || d.title}</figcaption>
		</figure>
	)}

	{(chipTinh.length > 0 || chipVi.length > 0 || chipQuyKinh.length > 0) && (
		<div class="dl-chips">
			{chipTinh.length > 0 && (
				<div class="dl-chip-hang">
					<span class="dl-chip-nhan">Tính</span>
					{chipTinh.map((x) => <span class="dl-chip dl-chip--tinh">{x}</span>)}
				</div>
			)}
			{chipVi.length > 0 && (
				<div class="dl-chip-hang">
					<span class="dl-chip-nhan">Vị</span>
					{chipVi.map((x) => <span class="dl-chip dl-chip--vi">{x}</span>)}
				</div>
			)}
			{chipQuyKinh.length > 0 && (
				<div class="dl-chip-hang">
					<span class="dl-chip-nhan">Quy kinh</span>
					{chipQuyKinh.map((x) => <span class="dl-chip dl-chip--qk">{x}</span>)}
				</div>
			)}
			{chipCongDung.length > 0 && (
				<div class="dl-chip-hang">
					<span class="dl-chip-nhan">Công dụng</span>
					{chipCongDung.map((x) => <span class="dl-chip dl-chip--cd">{x}</span>)}
				</div>
			)}
			{chipKiengKy.length > 0 && (
				<div class="dl-chip-hang">
					<span class="dl-chip-nhan">Kiêng kỵ</span>
					{chipKiengKy.map((x) => <span class="dl-chip dl-chip--kk">{x}</span>)}
				</div>
			)}
		</div>
	)}

	{bang.length > 0 && (
		<dl class="dl-bang">
			{bang.map(([k, v]) => (
				<>
					<dt>{k}</dt>
					<dd>{v}</dd>
				</>
			))}
		</dl>
	)}

	{coPhan.map(([k, nhan]) => <ThanMuc nhan={nhan.toUpperCase()} value={d[k]} />)}

	{coPhan.length === 0 && (
		<p class="dl-chua-soan">
			Mục từ này mới có phần tra nhanh ở bảng trên; phần diễn giải đang được biên soạn.
		</p>
	)}
</ThuVienKhung>

<style>
	.dl-vet {
		font-size: 0.83rem;
		color: var(--chu-nhat, #6b5f52);
		margin-bottom: 0.4rem;
	}
	.dl-vet a {
		color: var(--nau-700, #6f4a22);
		text-decoration: none;
	}
	.dl-anh {
		margin: 0 0 1.4rem;
		text-align: center;
	}
	.dl-anh img {
		max-width: 100%;
		height: auto;
		border: 1px solid var(--nau-100, #f1e7d6);
		border-radius: 10px;
		background: #fff;
	}
	.dl-anh figcaption {
		margin-top: 0.45rem;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--chu-nhat, #6b5f52);
	}
	.dl-chips {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0 0 1.5rem;
	}
	.dl-chip-hang {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem;
	}
	.dl-chip-nhan {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--nau-500, #a4743a);
		min-width: 4.6rem;
	}
	.dl-chip {
		font-size: 0.82rem;
		padding: 0.16rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--nau-200, #e3cfb0);
		background: #fff;
		color: var(--nau-800, #54391d);
	}
	.dl-chip--tinh { background: #fdf3e6; border-color: #f0dcc0; }
	.dl-chip--vi { background: #f2f7ee; border-color: #d8e6cc; }
	.dl-chip--qk { background: #eef3fa; border-color: #cfdcee; }
	.dl-chip--cd { background: #f6f0fa; border-color: #e0d0ec; }
	.dl-chip--kk { background: #fbeae5; border-color: #f0cfc8; color: #8a2b22; }
	.dl-bang {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.35rem 1.1rem;
		margin: 0 0 1.9rem;
		padding: 0.95rem 1.15rem;
		background: var(--nau-50, #faf6ef);
		border: 1px solid var(--nau-100, #f1e7d6);
		border-radius: 10px;
		font-size: 0.93rem;
	}
	.dl-bang dt {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--nau-600, #8a5e28);
		padding-top: 0.14rem;
	}
	.dl-bang dd {
		margin: 0;
		line-height: 1.6;
	}
	.dl-chua-soan {
		color: var(--chu-nhat, #6b5f52);
		font-style: italic;
		padding: 1.1rem;
		background: var(--nau-50, #faf6ef);
		border-radius: 9px;
	}
	@media (max-width: 560px) {
		.dl-anh {
		margin: 0 0 1.4rem;
		text-align: center;
	}
	.dl-anh img {
		max-width: 100%;
		height: auto;
		border: 1px solid var(--nau-100, #f1e7d6);
		border-radius: 10px;
		background: #fff;
	}
	.dl-anh figcaption {
		margin-top: 0.45rem;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--chu-nhat, #6b5f52);
	}
	.dl-chips {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0 0 1.5rem;
	}
	.dl-chip-hang {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem;
	}
	.dl-chip-nhan {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--nau-500, #a4743a);
		min-width: 4.6rem;
	}
	.dl-chip {
		font-size: 0.82rem;
		padding: 0.16rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--nau-200, #e3cfb0);
		background: #fff;
		color: var(--nau-800, #54391d);
	}
	.dl-chip--tinh { background: #fdf3e6; border-color: #f0dcc0; }
	.dl-chip--vi { background: #f2f7ee; border-color: #d8e6cc; }
	.dl-chip--qk { background: #eef3fa; border-color: #cfdcee; }
	.dl-chip--cd { background: #f6f0fa; border-color: #e0d0ec; }
	.dl-chip--kk { background: #fbeae5; border-color: #f0cfc8; color: #8a2b22; }
	.dl-bang {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
		.dl-bang dd {
			margin-bottom: 0.6rem;
		}
	}
</style>

---
// /thu-vien/<bo>/ — Trang một mục: khung hai cột, cột phải là lời dẫn của mục.
//
// Đây cũng là ĐƯỜNG BÒ của Google: mọi mục từ phải có ít nhất một liên kết tĩnh trỏ
// tới, mà ô tìm thì bot không gõ được — danh sách ở cột trái mới là thứ dẫn bot vào.
export const prerender = false;

import ThuVienKhung from "../../../layouts/ThuVienKhung.astro";
import { danhSachMuc, duyet } from "../../../lib/traCuu";

const bo = Astro.params.bo!;
const muc = await danhSachMuc();
const m = muc.find((x) => x.bo === bo);
if (!m || !m.so_muc) return Astro.redirect("/thu-vien/", 302);

const chuCai = (Astro.url.searchParams.get("van") || "").toUpperCase().slice(0, 1) || undefined;
const the = Astro.url.searchParams.get("the") || undefined;

// Vài mục mở đầu để cột phải không trống trơn và để bot có thêm liên kết.
const { muc: dau } = await duyet(bo, { chuCai, the, moiTrang: 24 });
const soMuc = (n: number) => n.toLocaleString("vi-VN");
---

<ThuVienKhung
	bo={bo}
	title={`${m.nhan} — Thư Viện Đông Y`}
	description={m.mo_ta}
	khongLap={!!chuCai || !!the}
>
	<h1>{m.nhan}</h1>
	<p class="tv-dan">{m.mo_ta} <b>{soMuc(m.so_muc)} mục từ.</b></p>
	<p class="tv-dan-nho">
		Gõ vào ô tìm bên trái — <b>không dấu cũng ra</b>. Hoặc chọn vần, chọn đặc tính rồi
		bấm một mục từ để xem đầy đủ.
	</p>

	<h2 class="tv-dan-h2">Mở đầu danh mục</h2>
	<ul class="tv-dan-ds">
		{
			dau.map((k) => (
				<li>
					<a href={`${k.duong_dan}${k.slug}/`}>
						<span class="ten">{k.tieu_de}</span>
						{k.ten_khac && <span class="khac">{k.ten_khac}</span>}
					</a>
				</li>
			))
		}
	</ul>
</ThuVienKhung>

<style>
	.tv-dan {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--chu-nhat);
		margin: 0 0 0.6rem;
	}
	.tv-dan b {
		color: var(--nau-800);
	}
	.tv-dan-nho {
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--chu-nhat);
		margin: 0 0 2rem;
		padding: 0.8rem 1rem;
		background: var(--nau-50);
		border: 1px solid var(--nau-100);
		border-radius: 9px;
	}
	.tv-dan-h2 {
		font-family: var(--serif);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--nau-600);
		margin: 0 0 0.8rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--vien);
	}
	.tv-dan-ds {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		column-gap: 2rem;
	}
	.tv-dan-ds li {
		break-inside: avoid;
		margin-bottom: 0.5rem;
	}
	.tv-dan-ds a {
		text-decoration: none;
	}
	.tv-dan-ds .ten {
		font-family: var(--serif);
		font-weight: 600;
		color: var(--nau-800);
	}
	.tv-dan-ds a:hover .ten {
		color: var(--do-an);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.tv-dan-ds .khac {
		display: block;
		font-size: 0.78rem;
		color: var(--chu-nhat);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.tv-dan-ds {
			columns: 1;
		}
	}
</style>

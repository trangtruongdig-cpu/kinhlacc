---
// /thu-vien/<bo>/ — Chuyển hướng về đường mục lục CŨ (/huyet/, /benh-hoc/…).
//
// Hai đường cùng dựng một nội dung là tự chia đôi tín hiệu của chính mình trước Google.
// Đường cũ đã nằm trong chỉ mục nên đường cũ là đường chính.
export const prerender = false;
import { danhSachMuc } from "../../../lib/traCuu";

const bo = Astro.params.bo!;
const m = (await danhSachMuc()).find((x) => x.bo === bo);
return Astro.redirect(m?.duong_dan ?? "/thu-vien/", 301);
---

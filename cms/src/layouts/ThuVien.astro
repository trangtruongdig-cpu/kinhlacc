---
// ThuVien.astro — Khung trang tra cứu. Cố ý KHÔNG dùng Base.astro (khung blog):
// thư viện là sách tra, đầu trang gọn, không cột bên, không thời gian đọc.
import "../styles/thu-vien.css";
import { Font } from "astro:assets";

interface Props {
	tieuDe: string;
	moTa?: string;
	chinhTac?: string;
	khongLap?: boolean;
}
const { tieuDe, moTa = "", chinhTac, khongLap = false } = Astro.props;
const url = chinhTac ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{tieuDe}</title>
		{moTa && <meta name="description" content={moTa} />}
		<link rel="canonical" href={url} />
		{/* Trang kết quả tra cứu sinh vô số URL theo từ khoá — để Google đánh chỉ mục
		    hết thì kho bị loãng bởi những trang gần như trống. Mục từ mới là thứ cần
		    lên chỉ mục, nên trang kết quả chỉ cho bò tiếp chứ không cho lưu. */}
		{khongLap && <meta name="robots" content="noindex,follow" />}
		<meta property="og:title" content={tieuDe} />
		<meta property="og:type" content="website" />
		{moTa && <meta property="og:description" content={moTa} />}
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-tu-dien" preload />
		<slot name="dau" />
	</head>
	<body class="tv">
		<header class="tv-dau">
			<div class="tv-dau-trong">
				<a class="tv-hieu" href="/thu-vien/">
					Thư Viện Đông Y <span>Kinh Lạc</span>
				</a>
				<a class="tv-ve" href="/">← Trang chủ</a>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="tv-chan">
			<div class="tv-trong">
				Tư liệu số hoá từ bộ từ điển Đông Y · <a href="/thu-vien/">Mục lục thư viện</a>
			</div>
		</footer>
	</body>
</html>

---
// ThuVienKhung.astro — Khung thư viện, dựng THEO ĐÚNG bản cũ của app.
//
// Người dùng yêu cầu giữ Y NGUYÊN bố cục và kiểu chữ; nên khung này KHÔNG tự đặt ra
// lớp CSS mới mà dùng lại chính bộ lớp .td-* của TuDienView.vue cũ (chép nguyên vào
// src/styles/tu-dien-goc.css) trên nền token của app (src/styles/app-token.css).
//
//   .tudien-page → .td-tabs → .td-shell → .td-aside (.td-search + .td-list) + .td-main
//
// ⚠️ Đừng "sửa cho đẹp hơn" mấy lớp này. Hai lần trước tôi tự dò lại từng luật và cả
// hai lần đều lệch — lệch mặt chữ (serif thay vì Inter) và lệch hình khối (nút bo
// tròn thay vì bo 10px). Muốn phát triển thêm thì THÊM lớp mới, đừng sửa lớp cũ.
import "../styles/app-token.css";
import "../styles/tu-dien-goc.css";
import "../styles/thu-vien.css";
import "../styles/tu-dien.css";
import { Font } from "astro:assets";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { danhSachMuc, duyet, chuCaiCua, theLocCua, chuCaiCuaMuc } from "../lib/traCuu";
import { truyVan } from "../lib/csdl";
import { urlAnh } from "../utils/anh";

interface Props {
	bo: string;
	slug?: string;
	title: string;
	description?: string | null;
	khongLap?: boolean;
	content?: { collection: string; id: string; slug?: string | null };
}
const { bo, slug, title, description, khongLap = false, content } = Astro.props;

const vanChon = (Astro.url.searchParams.get("van") || "").toUpperCase().slice(0, 1) || undefined;
const the = Astro.url.searchParams.get("the") || undefined;
const MOI_TRANG = 400;

// Đang mở một mục từ mà người đọc chưa tự chọn vần → mở sẵn đúng vần của mục đó.
const vanCuaMuc = slug ? await chuCaiCuaMuc(bo, slug) : undefined;
const chuCai = vanChon ?? vanCuaMuc;

const [muc, dsChu, dsThe, { muc: ds, tong }] = await Promise.all([
	danhSachMuc(),
	chuCaiCua(bo),
	theLocCua(bo),
	duyet(bo, { chuCai, the, moiTrang: MOI_TRANG }),
]);

const mucNay = muc.find((m) => m.bo === bo);
const duongMuc = mucNay?.duong_dan ?? `/thu-vien/${bo}/`;
const tongBo = mucNay?.so_muc ?? 0;
const soMuc = (n: number) => n.toLocaleString("vi-VN");

// Ảnh nhỏ + huy hiệu đếm trong danh sách — bản cũ có, và đó là thứ làm cột trái đọc
// được bằng mắt. Chỉ mục td_muc không giữ chúng nên hỏi thẳng bảng nội dung một lượt
// cho cả trang (slug = ANY(...)), không hỏi từng dòng.
const PHU: Record<string, { anh?: boolean; dem?: string; donVi?: string }> = {
	huyet_vi: { anh: true },
	duoc_lieu: { anh: true, dem: "so_bai_thuoc", donVi: "bài" },
	bai_thuoc: { dem: "so_benh", donVi: "bệnh" },
};
const phu = PHU[bo];
const kemTheo = new Map<string, { anh?: string; dem?: number }>();
if (phu && ds.length) {
	const cot = ["slug", phu.anh ? "anh" : null, phu.dem ?? null].filter(Boolean).join(", ");
	const hang = await truyVan<Record<string, unknown>>(
		`SELECT ${cot} FROM ec_${bo} WHERE slug = ANY($1::text[]) AND deleted_at IS NULL`,
		[ds.map((k) => k.slug)],
	);
	for (const h of hang) {
		kemTheo.set(String(h.slug), {
			anh: phu.anh ? urlAnh(h.anh, Astro.url.origin) : undefined,
			dem: phu.dem ? Number(h[phu.dem]) || undefined : undefined,
		});
	}
}

const coVan = new Map(dsChu.map((v) => [v.chu_cai, v.n]));
const CHU = [..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"];

const nhomThe: { nhom: string; ds: typeof dsThe }[] = [];
for (const t of dsThe) {
	let g = nhomThe.find((x) => x.nhom === t.nhom);
	if (!g) nhomThe.push((g = { nhom: t.nhom, ds: [] }));
	g.ds.push(t);
}
const theDangChon = dsThe.find((t) => t.ma_the === the);

const duong = (tham: Record<string, string | undefined>) => {
	const u = new URLSearchParams();
	for (const [k, x] of Object.entries({ van: chuCai, the, ...tham })) if (x) u.set(k, x);
	const q = u.toString();
	return `${duongMuc}${q ? `?${q}` : ""}`;
};

// Câu gợi ý trong ô tìm, lấy đúng chữ của bản cũ cho từng mục.
const GOI: Record<string, string> = {
	huyet_vi: "Tìm huyệt / mã (LU9, ST36…) / tên khác / chỉ định (Ho, Đau Đầu…)",
	kinh_mach: "Tìm kinh / mã (LU, ST…)",
	cham_cuu_tri_benh: "Tìm bệnh / triệu chứng / tên khác",
	benh_hoc: "Tìm bệnh / triệu chứng / tên khác",
	duoc_lieu: "Tìm vị thuốc / tên Hán / tên khoa học…",
	bai_thuoc: "Tìm bài thuốc…",
	nguon_y_van: "Tìm sách / tác giả…",
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: content ? "article" : "website",
	title,
	pageTitle: title,
	description,
	content,
	siteName: "Kinh Lạc Trương Gia",
});
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{khongLap && <meta name="robots" content="noindex,follow" />}
		<EmDashHead page={pageCtx} />
	</head>
	<body class="tv-than">
		<EmDashBodyStart page={pageCtx} />

		<header class="tv-dau">
			<div class="tv-dau-trong">
				<a class="tv-hieu" href="/thu-vien/">Thư Viện Đông Y <span>Kinh Lạc</span></a>
				<a class="tv-ve" href="/">← Trang chủ</a>
			</div>
		</header>

		<div class="tudien-page">
			{/* ── Thanh tab — lớp .td-tabs/.td-tab của bản cũ ─────────────── */}
			<div class="td-tabs">
				{
					muc
						.filter((m) => m.so_muc > 0)
						.map((m) => (
							<a href={m.duong_dan} class:list={["td-tab", m.bo === bo && "active"]}>
								{m.nhan}
							</a>
						))
				}
				<a href="/app/kinh-mach-3d" class="td-tab td-tab--link">🧭 Đồ Hình 3D</a>
			</div>

			<div class="td-shell">
				<aside class="td-aside">
					<div class="td-search">
						<input
							type="search"
							class="td-input"
							placeholder={GOI[bo] ?? `Tìm trong ${mucNay?.nhan ?? "mục"}…`}
							aria-label="Tìm trong mục"
							autocomplete="off"
							data-rai-tim
							data-bo={bo}
						/>
						<span class="td-count" data-rai-dem>{soMuc(tong)} / {soMuc(tongBo)}</span>
					</div>

					{
						nhomThe.length > 0 && (
							<div class="td-filter">
								<details class="tv-loc" open={!!the}>
									<summary>
										{theDangChon ? (
											<>
												⚲ <b>{theDangChon.ten}</b> <span class="tv-loc-bo">✕ bỏ lọc</span>
											</>
										) : (
											"⚲ Lọc Đặc Tính"
										)}
									</summary>
									<div class="tv-loc-than">
										{the && (
											<a class="tv-chip tv-chip-bo" href={duong({ the: undefined })}>
												✕ Bỏ lọc
											</a>
										)}
										{nhomThe.map((g) => (
											<>
												<p class="tv-loc-nhom">{g.nhom}</p>
												<div class="tv-chips">
													{g.ds.map((t) => (
														<a
															class={`tv-chip ${t.ma_the === the ? "dang" : ""}`}
															href={duong({ the: t.ma_the === the ? undefined : t.ma_the })}
														>
															{t.ten} <em>{soMuc(t.n)}</em>
														</a>
													))}
												</div>
											</>
										))}
									</div>
								</details>
							</div>
						)
					}

					<nav class="tv-van" aria-label="Tra theo vần">
						<a href={`${duongMuc}${the ? `?the=${the}&` : "?"}van=`} class={chuCai ? "" : "dang"}>Tất cả</a>
						{
							CHU.filter((c) => coVan.has(c)).map((c) => (
								<a
									href={duong({ van: c === chuCai ? undefined : c })}
									class={chuCai === c ? "dang" : ""}
									title={`${coVan.get(c)} mục`}
								>
									{c}
								</a>
							))
						}
					</nav>

					<ul class="td-list" data-rai-ds>
						{
							ds.map((k) => {
								const x = kemTheo.get(k.slug);
								return (
									<li class:list={[k.slug === slug && "active"]}>
										<a href={`${k.duong_dan}${k.slug}/`}>
											{phu?.anh &&
												(x?.anh ? (
													<img class="thumb" src={x.anh} alt="" loading="lazy" />
												) : (
													<span class="thumb no-thumb">◉</span>
												))}
											<span class="nm">
												{k.tieu_de}
												{k.ten_khac && <small>{k.ten_khac.split("\n")[0]?.slice(0, 60)}</small>}
											</span>
											{x?.dem ? (
												<span class="acu-nbenh">
													{soMuc(x.dem)} {phu?.donVi}
												</span>
											) : null}
										</a>
									</li>
								);
							})
						}
						{ds.length === 0 && <li class="td-empty">Không khớp mục nào.</li>}
					</ul>

					{
						tong > ds.length && (
							<p class="tv-rai-con">
								Còn {soMuc(tong - ds.length)} mục nữa — dùng ô tìm hoặc chọn vần ở trên.
							</p>
						)
					}
				</aside>

				<div class="td-main">
					<slot />
				</div>
			</div>
		</div>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Kéo mục đang xem vào tầm mắt TRONG cột trái.
			// ⚠️ Không dùng scrollIntoView: nó cuộn mọi khung cha, kéo luôn cả trang xuống
			// và đẩy thanh tab ra khỏi màn hình.
			const dang = document.querySelector<HTMLElement>(".td-list li.active");
			const khung = document.querySelector<HTMLElement>(".td-list");
			if (dang && khung) {
				khung.scrollTop = dang.offsetTop - khung.clientHeight / 2 + dang.clientHeight / 2;
			}

			// Ô tìm: gõ tới đâu lọc tới đó. Hỏi máy chủ thay vì tải cả danh mục về máy —
			// Bài Thuốc có 13.942 mục, tải hết là vài megabyte mỗi lượt vào trang.
			const o = document.querySelector<HTMLInputElement>("[data-rai-tim]");
			const ds = document.querySelector<HTMLUListElement>("[data-rai-ds]");
			const dem = document.querySelector<HTMLElement>("[data-rai-dem]");
			if (o && ds && dem) {
				const bo = o.dataset.bo || "";
				const goc = ds.innerHTML;
				const demGoc = dem.textContent || "";
				let hen: ReturnType<typeof setTimeout>;
				let phien = 0;

				const an = (t: string) =>
					String(t ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

				o.addEventListener("input", () => {
					clearTimeout(hen);
					const t = o.value.trim();
					if (t.length < 2) {
						ds.innerHTML = goc;
						dem.textContent = demGoc;
						return;
					}
					hen = setTimeout(async () => {
						const lan = ++phien;
						try {
							const r = await fetch(`/thu-vien/goi-y.json?q=${encodeURIComponent(t)}&bo=${bo}&n=60`);
							const kq = await r.json();
							if (lan !== phien) return; // bỏ kết quả về muộn khi gõ nhanh
							dem.textContent = `${kq.length} tìm thấy`;
							ds.innerHTML = kq.length
								? kq
										.map(
											(x: any) =>
												`<li><a href="${an(x.duong_dan)}${encodeURIComponent(x.slug)}/">` +
												`<span class="nm">${an(x.tieu_de)}` +
												(x.ten_khac ? `<small>${an(x.ten_khac)}</small>` : "") +
												`</span></a></li>`,
										)
										.join("")
								: `<li class="td-empty">Không khớp mục nào.</li>`;
						} catch {
							/* mạng hỏng thì giữ nguyên danh sách đang có */
						}
					}, 140);
				});
			}
		</script>
	</body>
</html>

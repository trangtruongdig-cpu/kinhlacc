---
// ThuVienKhung.astro — Khung thư viện theo BỐ CỤC CŨ của app:
//   thanh tab ngang  →  cột trái (ô tìm + bộ lọc + danh sách)  →  cột phải (nội dung).
//
// Khung này dùng chung cho CẢ trang mục (/thu-vien/<bo>/) lẫn trang một mục từ
// (/huyet/<slug>/, /duoc-lieu/<id>/…), nên người đọc đi từ mục này sang mục khác mà
// cột trái không biến mất — đúng như bản cũ.
import "../styles/thu-vien.css";
import "../styles/tu-dien.css";
import { Font } from "astro:assets";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { danhSachMuc, duyet, chuCaiCua, theLocCua, chuCaiCuaMuc } from "../lib/traCuu";

interface Props {
	bo: string;
	slug?: string;
	title: string;
	description?: string | null;
	khongLap?: boolean;
	content?: { collection: string; id: string; slug?: string | null };
}
const { bo, slug, title, description, khongLap = false, content } = Astro.props;

const vanChon = (Astro.url.searchParams.get("van") || "").toUpperCase().slice(0, 1) || undefined;
const the = Astro.url.searchParams.get("the") || undefined;
const MOI_TRANG = 400;

// Đang mở một mục từ mà người đọc chưa tự chọn vần → mở sẵn đúng vần của mục đó.
// Không làm vậy thì với 13.942 bài thuốc, mục đang xem nằm ngoài 400 dòng đầu và cột
// trái không hề cho thấy mình đang đứng ở đâu.
const vanCuaMuc = slug ? await chuCaiCuaMuc(bo, slug) : undefined;
const chuCai = vanChon ?? vanCuaMuc;

const [muc, dsChu, dsThe, { muc: ds, tong }] = await Promise.all([
	danhSachMuc(),
	chuCaiCua(bo),
	theLocCua(bo),
	duyet(bo, { chuCai, the, moiTrang: MOI_TRANG }),
]);

const mucNay = muc.find((m) => m.bo === bo);
// Mọi liên kết lọc/vần bám đường CŨ (/huyet/, /benh-hoc/…) — đó là đường chính.
const duongMuc = mucNay?.duong_dan ?? `/thu-vien/${bo}/`;
const tongBo = mucNay?.so_muc ?? 0;
const soMuc = (n: number) => n.toLocaleString("vi-VN");

const coVan = new Map(dsChu.map((v) => [v.chu_cai, v.n]));
const CHU = [..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"];

// Thẻ lọc gom theo nhóm, giữ thứ tự nhóm như dữ liệu trả về.
const nhomThe: { nhom: string; ds: typeof dsThe }[] = [];
for (const t of dsThe) {
	let g = nhomThe.find((x) => x.nhom === t.nhom);
	if (!g) nhomThe.push((g = { nhom: t.nhom, ds: [] }));
	g.ds.push(t);
}
const theDangChon = dsThe.find((t) => t.ma_the === the);

const duong = (tham: Record<string, string | undefined>) => {
	const u = new URLSearchParams();
	const v = { van: chuCai, the, ...tham };
	for (const [k, x] of Object.entries(v)) if (x) u.set(k, x);
	const q = u.toString();
	return `${duongMuc}${q ? `?${q}` : ""}`;
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: content ? "article" : "website",
	title,
	pageTitle: title,
	description,
	content,
	siteName: "Kinh Lạc Trương Gia",
});
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-tu-dien" preload />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{khongLap && <meta name="robots" content="noindex,follow" />}
		<EmDashHead page={pageCtx} />
	</head>
	<body class="tv">
		<EmDashBodyStart page={pageCtx} />

		<header class="tv-dau">
			<div class="tv-dau-trong">
				<a class="tv-hieu" href="/thu-vien/">
					Thư Viện Đông Y <span>Kinh Lạc</span>
				</a>
				<a class="tv-ve" href="/">← Trang chủ</a>
			</div>
		</header>

		{/* ── Thanh tab ngang ─────────────────────────────────────────── */}
		<nav class="tv-tab" aria-label="Các mục thư viện">
			<div class="tv-tab-trong">
				{
					muc
						.filter((m) => m.so_muc > 0)
						.map((m) => (
							<a href={m.duong_dan} class={m.bo === bo ? "dang" : ""}>
								{m.nhan}
							</a>
						))
				}
				<a href="/app/kinh-mach-3d" class="tv-tab-ngoai">🧭 Đồ Hình 3D</a>
			</div>
		</nav>

		<div class="tv-hai-cot">
			{/* ── Cột trái: ô tìm + bộ lọc + danh sách ────────────────── */}
			<aside class="tv-rai" aria-label={`Danh sách ${mucNay?.nhan ?? ""}`}>
				<div class="tv-rai-tim">
					<input
						type="search"
						placeholder={`Tìm trong ${mucNay?.nhan ?? "mục"}…`}
						aria-label="Tìm trong mục"
						data-rai-tim
						data-bo={bo}
						autocomplete="off"
					/>
					{/* Số KHỚP, không phải số dòng đang vẽ — cột trái chỉ dựng 400 dòng mỗi lượt,
				    hiện "400 / 1.045" thì người đọc tưởng bộ lọc chỉ bắt được 400. */}
					<span class="tv-rai-dem" data-rai-dem>{soMuc(tong)} / {soMuc(tongBo)}</span>
				</div>

				{
					nhomThe.length > 0 && (
						<details class="tv-loc" open={!!the}>
							<summary>
								{theDangChon ? (
									<>
										<b>{theDangChon.ten}</b> <span class="tv-loc-bo">✕ bỏ lọc</span>
									</>
								) : (
									"Lọc đặc tính"
								)}
							</summary>
							<div class="tv-loc-than">
								{the && (
									<a class="tv-chip tv-chip-bo" href={duong({ the: undefined })}>
										✕ Bỏ lọc
									</a>
								)}
								{nhomThe.map((g) => (
									<>
										<p class="tv-loc-nhom">{g.nhom}</p>
										<div class="tv-chips">
											{g.ds.map((t) => (
												<a
													class={`tv-chip ${t.ma_the === the ? "dang" : ""}`}
													href={duong({ the: t.ma_the === the ? undefined : t.ma_the })}
												>
													{t.ten} <em>{soMuc(t.n)}</em>
												</a>
											))}
										</div>
									</>
								))}
							</div>
						</details>
					)
				}

				<nav class="tv-van" aria-label="Tra theo vần">
					<a href={`${duongMuc}${the ? `?the=${the}&` : "?"}van=`} class={chuCai ? "" : "dang"}>Tất cả</a>
					{
						CHU.filter((c) => coVan.has(c)).map((c) => (
							<a
								href={duong({ van: c === chuCai ? undefined : c })}
								class={chuCai === c ? "dang" : ""}
								title={`${coVan.get(c)} mục`}
							>
								{c}
							</a>
						))
					}
				</nav>

				<ul class="tv-rai-ds" data-rai-ds>
					{
						ds.map((k) => (
							<li>
								<a href={`${k.duong_dan}${k.slug}/`} class={k.slug === slug ? "dang" : ""}>
									<span class="ten">{k.tieu_de}</span>
									{k.ten_khac && <span class="khac">{k.ten_khac}</span>}
								</a>
							</li>
						))
					}
				</ul>

				{
					tong > ds.length && (
						<p class="tv-rai-con">
							Còn {soMuc(tong - ds.length)} mục nữa — dùng ô tìm hoặc chọn vần ở trên.
						</p>
					)
				}
			</aside>

			{/* ── Cột phải: nội dung ──────────────────────────────────── */}
			<main class="tv-noi-dung">
				<article class="dl-article">
					<slot />
				</article>
			</main>
		</div>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Kéo mục đang xem vào tầm mắt trong CỘT TRÁI.
			// ⚠️ Không dùng scrollIntoView: nó cuộn mọi khung cha, tức kéo luôn cả trang
			// xuống và đẩy thanh tab ra khỏi màn hình. Đặt thẳng scrollTop của danh sách.
			const dang = document.querySelector<HTMLElement>(".tv-rai-ds a.dang");
			const khung = document.querySelector<HTMLElement>(".tv-rai-ds");
			if (dang && khung) {
				khung.scrollTop = dang.offsetTop - khung.clientHeight / 2 + dang.clientHeight / 2;
			}

			// Ô tìm ở cột trái: gõ tới đâu lọc tới đó. Hỏi máy chủ thay vì tải cả danh
			// mục về máy — Bài Thuốc có 13.942 mục, tải hết là vài megabyte mỗi lượt vào.
			const o = document.querySelector<HTMLInputElement>("[data-rai-tim]");
			const ds = document.querySelector<HTMLUListElement>("[data-rai-ds]");
			const dem = document.querySelector<HTMLElement>("[data-rai-dem]");
			if (o && ds && dem) {
				const bo = o.dataset.bo || "";
				const goc = ds.innerHTML;
				const demGoc = dem.textContent || "";
				let hen: ReturnType<typeof setTimeout>;
				let phien = 0;

				const an = (t: string) =>
					String(t ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

				o.addEventListener("input", () => {
					clearTimeout(hen);
					const t = o.value.trim();
					if (t.length < 2) {
						ds.innerHTML = goc;
						dem.textContent = demGoc;
						return;
					}
					hen = setTimeout(async () => {
						const lan = ++phien;
						try {
							const r = await fetch(
								`/thu-vien/goi-y.json?q=${encodeURIComponent(t)}&bo=${bo}&n=60`,
							);
							const kq = await r.json();
							if (lan !== phien) return; // bỏ kết quả về muộn khi gõ nhanh
							dem.textContent = `${kq.length} tìm thấy`;
							ds.innerHTML = kq.length
								? kq
										.map(
											(x: any) =>
												`<li><a href="${an(x.duong_dan)}${encodeURIComponent(x.slug)}/">` +
												`<span class="ten">${an(x.tieu_de)}</span>` +
												(x.ten_khac ? `<span class="khac">${an(x.ten_khac)}</span>` : "") +
												`</a></li>`,
										)
										.join("")
								: `<li class="tv-rai-khong">Không có mục nào khớp “${an(t)}”.</li>`;
						} catch {
							/* mạng hỏng thì giữ nguyên danh sách đang có */
						}
					}, 140);
				});
			}
		</script>
	</body>
</html>
